{
  "opencollection": "1.0.0",
  "info": {
    "name": "env0 Agents Environments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Environments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.env0.com/environments",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List environments"
        },
        {
          "info": {
            "name": "Create an environment and trigger deployment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.env0.com/environments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an environment and trigger deployment"
        },
        {
          "info": {
            "name": "Get an environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.env0.com/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an environment"
        },
        {
          "info": {
            "name": "Destroy and delete an environment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.env0.com/environments/:environmentId",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Destroy and delete an environment"
        }
      ]
    }
  ],
  "bundled": true
}